# --- データルート ---
# 【MediaVault専用領域】アップロードされたファイルの書込先。（必須。docker-compose.yml側にデフォルト値は持たない）
MEDIAVAULT_ROOT=/srv/mediavault

# --- タイムゾーン ---（必須）
TZ=Asia/Tokyo

# --- 外部から注入されるリバースプロキシ用ネットワーク名 ---
# minipc-compose 等、本グループ外で作成される proxy-net の実名を指定する（必須）
PROXY_NET_NAME=proxy-net

# --- MediaVault用 PostgreSQL 認証情報 ---
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediavault

# --- mediavault-api の内部API（/internal/*）Bearer認証キー（必須） ---
# 未設定だとAPI側で空文字となり内部APIが無認証になるため、compose側で :? 必須指定にしている
INTERNAL_API_KEY=change-me

# --- mediavault-web を配信するオリジン（単一のみ。不正値はapi起動時panic。必須） ---
CORS_ALLOWED_ORIGIN=https://mediavault.aoton.win

# --- 外部メタデータAPIの認証情報（未設定のプロバイダは起動時seedをスキップし、取込が使えない） ---
# 映画・TV
TMDB_API_KEY=
# ゲーム
STEAM_API_KEY=
STEAM_USER_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# アニメ
ANNICT_ACCESS_TOKEN=
# 小説/本/漫画
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# --- mediavault-worker 用 LLM 接続情報（worker 有効化時に設定） ---
LLM_BASE_URL=
LLM_API_KEY=
