# MediaVault 単体起動用設定。
# このファイルを .env にコピーし、秘密情報を設定してから起動する。

# 共通
TZ=Asia/Tokyo
BIND_ADDRESS=127.0.0.1
MEDIAVAULT_WEB_PORT=8080

# MediaVault
MEDIAVAULT_ALLOWED_ORIGIN=http://127.0.0.1:8080
MEDIAVAULT_DB_PASSWORD=change-me

# 内部API用キー。api / mcp / extractor で共有する必須項目。
# openssl rand -base64 32 で生成した値を設定する
INTERNAL_API_KEY=

# MediaVault-mcp
# openssl rand -base64 48 で生成した値を設定する
MCP_AUTH_TOKEN=
# LAN内からの直接アクセス用。特定インターフェースに限定したい場合はホストIPを指定する
MCP_BIND_ADDRESS=0.0.0.0
# ホスト側の公開ポート。他のスタックと8081が競合する場合に変更する
MEDIAVAULT_MCP_PORT=8081
# mcp のログレベル (error/warn/info/debug/trace)
RUST_LOG=info

# MediaVault-extractor
# OCR 実行デバイス。cpu / cuda
EXTRACTOR_OCR_DEVICE=cpu
EXTRACTOR_MAX_CONCURRENCY=1
EXTRACTOR_POLL_INTERVAL_SEC=5
EXTRACTOR_HEARTBEAT_INTERVAL_SEC=30
EXTRACTOR_LEASE_SECONDS=300
EXTRACTOR_JOB_TIMEOUT_SEC=3600

# 共有ライブラリ。既定の名前付きボリューム、またはホストの絶対パスを指定する。
LIBRARY_SOURCE=shares
# 既定の名前付きボリューム、またはホストの絶対パスを指定する。
MEDIAVAULT_DB_SOURCE=mediavault-db
MEDIAVAULT_STORAGE_SOURCE=mediavault-storage

# 外部メタデータ API。未設定のプロバイダーは利用できない。
TMDB_API_KEY=
STEAM_API_KEY=
STEAM_USER_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ANNICT_ACCESS_TOKEN=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
