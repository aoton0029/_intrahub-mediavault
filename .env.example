# docker-compose.yml（本番用）の環境変数
# 使い方: cp .env.production.example .env.production → 値を書き換える
#   docker compose -p mediavault --env-file .env.production up -d --build
#
# 本ファイルの責務: docker-compose.yml 内の ${...} 展開のみ（環境依存値と秘密）。
# イメージ指定は含まない（自作サービスは build:、OSSはcompose内に固定）。
#
# 参照元: インフラ設計/デバイス/ミニPC/サービス/MediaVault/README.md の「環境変数（環境依存値）」

# --- データルート ---
# データルートの基点（既定 /srv）。MEDIA_ROOT / DOCUMENTS_ROOT 未設定時の親ディレクトリの目安。
DATA_ROOT=/srv
# 【実データ領域】動画・写真の実体パス（Jellyfin・mediavault-api/workerが参照）。
# 録画・手動配置データの置き場。mediavault-api は read-only でマウントし、Item へは
# POST /items/:id/files で絶対パスを登録してリンクする（コピー・移動はしない）
MEDIA_ROOT=/srv/media
# 【実データ領域】PDF・マンガの実体パス（Calibre-Web・mediavault-api/workerが参照）
DOCUMENTS_ROOT=/srv/documents
# 【MediaVault専用領域】アップロードされたファイルの書込先。
# この配下に video/ image/ audio/ pdf/ archive/ other/ が自動で作られる（mediavault-apiのみが書き込む）
VAULT_ROOT=/srv/mediavault

# --- タイムゾーン / ファイル所有者 ---
TZ=Asia/Tokyo
PUID=1000
PGID=1000

# --- 外部から注入されるリバースプロキシ用ネットワーク名 ---
# minipc-compose 等、本グループ外で作成される proxy-net の実名を指定する
PROXY_NET_NAME=proxy-net

# --- MediaVault用 PostgreSQL 認証情報 ---
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediavault

# --- mediavault-api の内部API（/internal/*）Bearer認証キー（必須） ---
# 未設定だとAPI側で空文字となり内部APIが無認証になるため、compose側で :? 必須指定にしている
INTERNAL_API_KEY=change-me

# --- mediavault-web を配信するオリジン（単一のみ。不正値はapi起動時panic） ---
CORS_ALLOWED_ORIGIN=https://mediavault.aoton.win

# --- 外部メタデータAPIの認証情報（未設定のプロバイダは起動時seedをスキップし、取込が使えない） ---
# 映画・TV
TMDB_API_KEY=
# ゲーム
STEAM_API_KEY=
STEAM_USER_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# アニメ
ANNICT_ACCESS_TOKEN=
# 小説/本/漫画
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
