# docker-compose.test.yml（ローカル結合確認用）の環境変数
# 使い方: cp .env.test.example .env.test → 値を書き換える
#   docker compose -f docker-compose.test.yml --env-file .env.test up -d
#
# このファイルの責務: docker-compose.test.yml 内の ${...} 展開のみ。
# backend プロセスに渡すアプリ設定（DATABASE_URL・外部APIキー等）は backend/.env に置く
# （test compose が env_file で読み込む）。ここには書かない。

# --- ローカル用 PostgreSQL 認証情報（db サービス） ---
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mediavault

# --- pgAdmin ログイン情報（未設定時は admin@example.com / admin） ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
