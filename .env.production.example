# docker-compose.yml（本番用）の環境変数
# 使い方: cp .env.production.example .env.production → 値を書き換える
#   docker compose -p mediavault --env-file .env.production up -d
#
# 参照元: インフラ設計/デバイス/ミニPC/サービス/MediaVault/README.md の「環境変数（環境依存値）」

# --- データルート ---
# データルートの基点（既定 /srv）。MEDIA_ROOT / DOCUMENTS_ROOT 未設定時の親ディレクトリの目安。
DATA_ROOT=/srv
# 動画・写真の実体パス（Jellyfin・mediavault-api/workerが参照）
MEDIA_ROOT=/srv/media
# PDF・マンガの実体パス（Calibre-Web・mediavault-api/workerが参照）
DOCUMENTS_ROOT=/srv/documents

# --- タイムゾーン / ファイル所有者 ---
TZ=Asia/Tokyo
PUID=1000
PGID=1000

# --- 外部から注入されるリバースプロキシ用ネットワーク名 ---
# minipc-compose 等、本グループ外で作成される proxy-net の実名を指定する
PROXY_NET_NAME=proxy-net

# --- MediaVault用 PostgreSQL 認証情報 ---
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediavault

# --- mediavault-api の検索バックエンド切替（未設定時はPostgreSQL全文検索） ---
SEARCH_BACKEND=postgres
MEILI_URL=

# --- mediavault-worker が wiki/embed ジョブを自ら実行する場合のみ使用 ---
# （既定ではKnowledgeHub側エージェントに委譲するため空でよい）
LLM_BASE_URL=
LLM_API_KEY=

# --- 自作イメージ（GitHub Actions で GHCR へ push。コミットSHAタグまたはSemVerタグを固定指定） ---
MEDIAVAULT_API_IMAGE=ghcr.io/change-me/mediavault-api:change-me
MEDIAVAULT_WEB_IMAGE=ghcr.io/change-me/mediavault-web:change-me
MEDIAVAULT_WORKER_IMAGE=ghcr.io/change-me/mediavault-worker:change-me
MEDIAVAULT_MCP_IMAGE=ghcr.io/change-me/mediavault-mcp:change-me
MEDIAVAULT_MIGRATE_IMAGE=ghcr.io/change-me/mediavault-migrate:change-me

# --- バンドルOSSイメージ（メジャーバージョン固定。:latest は使用しない） ---
JELLYFIN_IMAGE=jellyfin/jellyfin:10
CALIBRE_WEB_IMAGE=lscr.io/linuxserver/calibre-web:0.6
