# mediavault-api（backend）のアプリ設定
# 使い方: cp .env.example .env → 値を書き換える
#   cd backend && cargo run -p mediavault-api   （main.rs が dotenvy で本ファイルを読む）
#   cd backend && cargo test --workspace
#
# このファイルの責務: composeを使わずホスト上で直接 cargo run / cargo test するときの設定。
# docker-compose.test.yml は env_file で本ファイルを読み込むが、コンテナ内の事情に依存する値
# （DATABASE_URL・*_STORAGE_PATH）は compose 側の environment: で上書きされる。
# 本番（docker-compose.yml）では本ファイルは一切使わず、リポジトリルートの .env から compose の
# environment: 経由で注入される。同じ値をここと本番envの両方に書かないこと。

# --- DB接続（ホストのPostgreSQLを指す。POSTGRES_* はコンテナ側の設定なのでここには置かない） ---
DATABASE_URL=postgresql://mediavault:changeme@localhost:5432/mediavault

# --- HTTPサーバー（未設定時 APP_PORT=8080 / CORS_ALLOWED_ORIGIN=http://localhost） ---
# CORS_ALLOWED_ORIGIN は単一オリジンのみ指定可（main.rs。不正値は起動時panic）
APP_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- 内部API（/internal/*）のBearer認証キー。未設定だと空文字となり認証が機能しない ---
INTERNAL_API_KEY=changeme

# --- アップロード書込先（MediaVault専用領域。未設定時のルートは /srv/mediavault） ---
# 保存先は STORAGE_ROOT + ファイル種別サブディレクトリ で決まる。
# 読み取り専用のアニメ・実写・マンガ領域とは別領域であり、
# 実データは POST /items/:id/files で絶対パスを登録してリンクする（コピーしない）。
STORAGE_ROOT=./.local/vault

# 種別ごとのサブディレクトリ（既定値のままでよければ設定不要）。
# ルート外への脱出（絶対パス・"..") を含む値は無視され既定値が使われる。
#STORAGE_SUBDIR_VIDEO=video
#STORAGE_SUBDIR_IMAGE=image
#STORAGE_SUBDIR_AUDIO=audio
#STORAGE_SUBDIR_PDF=pdf
#STORAGE_SUBDIR_ARCHIVE=archive
#STORAGE_SUBDIR_OTHER=other

# --- 外部メタデータAPIの認証情報（未設定のプロバイダは起動時seedをスキップ／該当テストもskip） ---
# 映画・TV
TMDB_API_KEY=changeme
# ゲーム
STEAM_API_KEY=changeme
STEAM_USER_ID=changeme
IGDB_CLIENT_ID=changeme
IGDB_CLIENT_SECRET=changeme
# アニメ
ANNICT_ACCESS_TOKEN=changeme
# 小説/本/漫画
RAKUTEN_APPLICATION_ID=changeme
RAKUTEN_ACCESS_KEY=changeme
