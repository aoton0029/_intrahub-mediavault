# mediavault-mcp のアプリ設定
# 使い方: cp .env.example .env → 値を書き換える
#   cd backend/mediavault-mcp && cargo run    （main.rs が dotenvy で本ファイルを読む）
#
# 秘密情報（MCP_AUTH_TOKEN / INTERNAL_API_KEY）はここに実値を書かないこと。
# 生成例: openssl rand -base64 48

# --- 必須: Bearer認証トークン。未設定・空文字・空白のみだと起動失敗する ---
MCP_AUTH_TOKEN=

# --- 任意: 読み取り専用トークン（設計決定 D-10） ---
# 設定すると、このトークンで接続したセッションでは tools/list が読み取り専用ツール
# （health / search_library / search_external_catalog / get_item_context /
#   collection_overview / list_citations）のみを返し、書き込みツールの呼び出しも拒否される。
# 未設定なら従来どおり MCP_AUTH_TOKEN 単独運用（全ツール公開）。
#
# 用途: 知識生成エージェント等、読み取りしか必要としないクライアントへ配る。
# MCP_AUTH_TOKEN と同じ値にすると起動失敗する（read-only のつもりで全権を配る事故を防ぐため）。
#MCP_READONLY_TOKEN=

# --- 必須: mediavault-api のベースURL ---
MEDIAVAULT_API_BASE_URL=http://mediavault-api:8080

# --- 任意: 内部API用キー。MVPのツールは公開API（認証不要）のみを使うため未設定でも起動する ---
INTERNAL_API_KEY=

# --- 任意: 待受アドレス（既定 0.0.0.0:8081） ---
#MCP_BIND_ADDR=0.0.0.0:8081

# --- 任意: タイムアウト（秒）。既定 接続=3 / 全体=15 / 外部カタログ検索=30 ---
#MCP_CONNECT_TIMEOUT_SECS=3
#MCP_REQUEST_TIMEOUT_SECS=15
#MCP_EXTERNAL_TIMEOUT_SECS=30
