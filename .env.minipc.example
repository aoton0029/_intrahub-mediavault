# docker-compose.minipc.yml 用環境変数(minipc-compose/.env.example の MediaVault セクション相当)
# 使い方: cp .env.minipc.example .env.minipc → 値を書き換える

# データルート(バインドマウントの基点。コンテナ側パスは /srv 固定のまま)
DATA_ROOT=/srv
TZ=Asia/Tokyo

# GitHub Actions でビルドし GHCR から配信する自作イメージ(コミット SHA タグ固定)
MEDIAVAULT_BACKEND_IMAGE=ghcr.io/change-me/mediavault-backend:change-me
MEDIAVAULT_FRONTEND_IMAGE=ghcr.io/change-me/mediavault-frontend:change-me

# MediaVault 用 PostgreSQL の認証情報
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediavault

# backend の /internal API キー(KindleOCR 等が使用)
MEDIAVAULT_INTERNAL_API_KEY=change-me
